/*
 * CareMate wearable — secrets template.
 *
 * Copy this file to secrets.h (which is gitignored) and fill in real values.
 * NEVER commit secrets.h. See CONTRIBUTING.md.
 *
 * For the demo the network is a phone hotspot with no internet dependency:
 *   - Aryan's phone provides the hotspot (SSID / password below).
 *   - The UNO Q hub joins it and listens on HUB_HOST:HUB_PORT (use a fixed
 *     address — a DHCP reservation or the hotspot's known gateway range).
 *   - The teammate's phone runs the iOS client on the same hotspot.
 */

#ifndef CAREMATE_WEARABLE_SECRETS_H
#define CAREMATE_WEARABLE_SECRETS_H

#define WIFI_SSID     "your-hotspot-ssid"
#define WIFI_PASSWORD "your-hotspot-password"

// UNO Q hub — the machine running the caremate_hub server / WearableSource.
#define HUB_HOST "192.168.1.50"
#define HUB_PORT 9000

#endif  // CAREMATE_WEARABLE_SECRETS_H
